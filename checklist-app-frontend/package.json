{
  "name": "checklist-app-frontend",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "npm run cleanup && expo start --clear",
    "start:lan": "npm run cleanup && expo start --clear --host lan",
    "start:tunnel": "npm run cleanup && expo start --clear --tunnel",
    "android": "npm run cleanup && expo start --android",
    "ios": "npm run cleanup && expo start --ios",
    "web": "npm run cleanup && expo start --web",
    "cleanup": "npm run kill-ports",
    "kill-ports": "npx kill-port 8081 8082 19000 19001 19002 || echo 'No processes to kill'",
    "kill-node": "taskkill /F /IM node.exe 2>nul || echo 'No node processes'",
    "full-cleanup": "npm run kill-node && npm run kill-ports && rimraf .expo && npm cache clean --force",
    "dev": "npm run start:lan",
    "reset": "npm run full-cleanup && npm install && npm run start:lan",
    "lint": "expo lint",
    "reset-project": "node ./scripts/reset-project.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.3.12",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/material-top-tabs": "^7.3.7",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/stack": "^7.3.1",
    "axios": "^1.9.0",
    "expo": "~54.0.33",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-file-system": "~19.0.13",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  }
}
